      "confidence": "low"
    },
    {
      "component": "article-body",
      "selectors": ["article", "main article"],
      "confidence": "medium"
    },
    {
      "component": "footer",
      "selectors": ["footer"],
      "confidence": "medium"
    }
  ],
  "notes": "DRAFT. Selectors written from general knowledge of the page structure; NOT verified against the live DOM (the session network cannot reach this site). urlPattern is matched against the URL path only. Verify with adapters/VERIFY.md before changing status to tested."
