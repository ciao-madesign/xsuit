{
  "name": "xsuit",
  "version": "0.0.1",
  "private": true,
  "description": "xsuit: a suitable UX outfit for every target market (cross-market UX localization extension).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "evidence": "node scripts/evidence-report.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "replication": "node scripts/replication.mjs",
    "corpus": "node scripts/corpus-report.mjs",
    "lock": "node scripts/lock-data.mjs",
    "adapters": "node scripts/run-ts.mjs src/research/adapters-cli.ts",
    "validate:browser": "npm run build && node scripts/validate-browser.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.0.280",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
