{
  "manifest_version": 3,
  "name": "xsuit",
  "version": "0.0.1",
  "description": "A suitable UX outfit for every target market.",
  "action": { "default_popup": "popup.html", "default_title": "xsuit" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "permissions": ["storage", "activeTab"]
}
