{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit comparison report (xsuit.report/3)",
  "description": "CLOSED. Screenshots are never part of the file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "createdAt",
    "page",
    "profile",
    "depth",
    "pageType",
    "transformed",
    "rules",
    "undoneByGuard",
    "skipped",
    "metrics",
    "notes",
    "scorecard"
  ],
  "properties": {
    "schema": {
      "const": "xsuit.report/3"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "pageType"],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
          "maxLength": 253
        },
        "pageType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        }
      }
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "depth": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "pageType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "transformed": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "version",
          "dimension",
          "pole",
          "evidence",
          "sources",
          "confidence",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "evidence": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "elements": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "dimension": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "pole": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "sources": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,40}$"
            }
          },
          "confidence": {
            "enum": ["low", "medium", "high", "n/a"]
          }
        }
      }
    },
    "undoneByGuard": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "reason"],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "reason"],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "before", "after", "delta"],
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{1,40}$"
          },
          "before": {
            "type": ["number", "null"]
          },
          "after": {
            "type": ["number", "null"]
          },
          "delta": {
            "type": ["number", "null"]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclaimer", "rows"],
      "properties": {
        "disclaimer": {
          "type": "string",
          "maxLength": 300
        },
        "rows": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "name",
              "family",
              "measured",
              "reference",
              "position",
              "nearest",
              "poles",
              "note"
            ],
            "properties": {
              "dimension": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              },
              "name": {
                "type": "string",
                "maxLength": 300
              },
              "family": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              },
              "measured": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["metric", "before", "after"],
                  "properties": {
                    "metric": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]{1,40}$"
                    },
                    "before": {
                      "type": ["number", "null"]
                    },
                    "after": {
                      "type": ["number", "null"]
                    }
                  }
                }
              },
              "reference": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["metric", "west", "china", "source", "provisional"],
                    "properties": {
                      "metric": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9]{1,40}$"
                      },
                      "west": {
                        "type": "number"
                      },
                      "china": {
                        "type": "number"
                      },
                      "source": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]{1,40}$"
                      },
                      "provisional": {
                        "const": true
                      }
                    }
                  }
                ]
              },
              "position": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["before", "after"],
                    "properties": {
                      "before": {
                        "type": ["number", "null"]
                      },
                      "after": {
                        "type": ["number", "null"]
                      }
                    }
                  }
                ]
              },
              "nearest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["before", "after"],
                    "properties": {
                      "before": {
                        "enum": ["western", "china", "in-between", null]
                      },
                      "after": {
                        "enum": ["western", "china", "in-between", null]
                      }
                    }
                  }
                ]
              },
              "poles": {
                "type": "object",
                "additionalProperties": false,
                "required": ["western", "china"],
                "properties": {
                  "western": {
                    "type": ["string", "null"],
                    "pattern": "^[a-z][a-z0-9-]{0,40}$"
                  },
                  "china": {
                    "type": ["string", "null"],
                    "pattern": "^[a-z][a-z0-9-]{0,40}$"
                  }
                }
              },
              "note": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    }
  }
}
