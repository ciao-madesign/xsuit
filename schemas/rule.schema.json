{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit Transformation Rule",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "description",
    "profile",
    "level",
    "mode",
    "pageTypes",
    "components",
    "conditions",
    "action",
    "dependencies",
    "priority",
    "reversible",
    "risk",
    "fallback",
    "evidence",
    "limits",
    "testResults",
    "rationale"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": ["western", "china", "hybrid"]
    },
    "level": {
      "enum": ["visual", "information-architecture", "interaction", "ecosystem"]
    },
    "mode": {
      "enum": ["visual", "structural"]
    },
    "pageTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "any",
          "home",
          "search-results",
          "product-list",
          "product-detail",
          "article",
          "feed",
          "video"
        ]
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "header",
          "primary-nav",
          "search-box",
          "hero",
          "carousel",
          "promo-banner",
          "product-card",
          "product-grid",
          "filters",
          "recommendations",
          "headline-list",
          "article-body",
          "feed-item",
          "video-player",
          "sidebar",
          "comments",
          "ads",
          "footer"
        ]
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "component-present",
              "component-absent",
              "viewport-min-width",
              "confidence-min"
            ]
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "set-token",
            "emphasize",
            "de-emphasize",
            "collapse",
            "reorder",
            "group",
            "surface-shortcut"
          ]
        },
        "token": {
          "enum": [
            "density",
            "spacing-scale",
            "palette-saturation",
            "type-scale",
            "image-prominence",
            "visual-hierarchy",
            "link-affordance"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "reversible": {
      "const": true
    },
    "risk": {
      "enum": ["low", "medium"]
    },
    "fallback": {
      "enum": ["skip", "visual-only", "original"]
    },
    "evidence": {
      "type": "object",
      "required": ["level", "summary", "sources", "gaps"],
      "properties": {
        "level": {
          "enum": ["strong", "moderate", "emerging", "hypothesis"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "locator", "supports"],
            "properties": {
              "id": {
                "type": "string"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "supports": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validationPlan": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "testResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["site", "date", "outcome"],
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "outcome": {
            "enum": ["untested", "pass", "partial", "fail"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 40
    }
  }
}
