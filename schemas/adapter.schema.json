{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit Site Adapter",
  "type": "object",
  "required": ["id", "site", "hosts", "status", "pageTypeHints", "components"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "site": {
      "type": "string",
      "minLength": 1
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
      }
    },
    "status": {
      "enum": ["draft", "tested"]
    },
    "pageTypeHints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pageType", "urlPattern"],
        "properties": {
          "pageType": {
            "enum": [
              "any",
              "home",
              "search-results",
              "product-list",
              "product-detail",
              "article",
              "feed",
              "video"
            ]
          },
          "urlPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "selectors", "confidence"],
        "properties": {
          "component": {
            "enum": [
              "header",
              "primary-nav",
              "search-box",
              "hero",
              "carousel",
              "promo-banner",
              "product-card",
              "product-grid",
              "filters",
              "recommendations",
              "headline-list",
              "article-body",
              "feed-item",
              "video-player",
              "sidebar",
              "comments",
              "ads",
              "footer"
            ]
          },
          "selectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 8
          },
          "confidence": {
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "required": ["checkedOn", "browser", "pageTypes", "sheet"],
      "additionalProperties": false,
      "properties": {
        "checkedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "pageTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sheet": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.json$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "tested"
          }
        }
      },
      "then": {
        "required": ["verification"]
      },
      "else": {
        "not": {
          "required": ["verification"]
        }
      }
    }
  ]
}
