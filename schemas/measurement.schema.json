{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit measurement file (xsuit.metrics/2)",
  "description": "CLOSED: no field outside this list may appear. No page text, URL path, query string or personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capturedAt",
    "page",
    "viewport",
    "hasLayout",
    "sampledElements",
    "metrics",
    "definitions"
  ],
  "properties": {
    "schema": {
      "const": "xsuit.metrics/2"
    },
    "capturedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "pageType", "lang"],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
          "maxLength": 253
        },
        "pageType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        },
        "lang": {
          "type": "string",
          "pattern": "^([a-z]{2,3}(-[a-z0-9]{2,8})?)?$"
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        }
      }
    },
    "hasLayout": {
      "type": "boolean"
    },
    "sampledElements": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageHeightPx",
        "mediaPer1000Px",
        "imageCount",
        "videoCount",
        "textUnits",
        "textUnitsPer1000Px",
        "headingsPer1000Text",
        "paragraphsPer1000Text",
        "mainBlocks",
        "peripheralBlocks",
        "linkCount",
        "interactivePer1000Px",
        "underlinedLinkRatio",
        "footerLinkCount",
        "autoplayCount",
        "qrCodeCount",
        "meanSaturation",
        "meanLightness",
        "distinctHues",
        "whitespaceRatio"
      ],
      "properties": {
        "pageHeightPx": {
          "type": ["number", "null"]
        },
        "mediaPer1000Px": {
          "type": ["number", "null"]
        },
        "imageCount": {
          "type": ["number", "null"]
        },
        "videoCount": {
          "type": ["number", "null"]
        },
        "textUnits": {
          "type": ["number", "null"]
        },
        "textUnitsPer1000Px": {
          "type": ["number", "null"]
        },
        "headingsPer1000Text": {
          "type": ["number", "null"]
        },
        "paragraphsPer1000Text": {
          "type": ["number", "null"]
        },
        "mainBlocks": {
          "type": ["number", "null"]
        },
        "peripheralBlocks": {
          "type": ["number", "null"]
        },
        "linkCount": {
          "type": ["number", "null"]
        },
        "interactivePer1000Px": {
          "type": ["number", "null"]
        },
        "underlinedLinkRatio": {
          "type": ["number", "null"]
        },
        "footerLinkCount": {
          "type": ["number", "null"]
        },
        "autoplayCount": {
          "type": ["number", "null"]
        },
        "qrCodeCount": {
          "type": ["number", "null"]
        },
        "meanSaturation": {
          "type": ["number", "null"]
        },
        "meanLightness": {
          "type": ["number", "null"]
        },
        "distinctHues": {
          "type": ["number", "null"]
        },
        "whitespaceRatio": {
          "type": ["number", "null"]
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageHeightPx": {
          "type": "string",
          "maxLength": 200
        },
        "mediaPer1000Px": {
          "type": "string",
          "maxLength": 200
        },
        "imageCount": {
          "type": "string",
          "maxLength": 200
        },
        "videoCount": {
          "type": "string",
          "maxLength": 200
        },
        "textUnits": {
          "type": "string",
          "maxLength": 200
        },
        "textUnitsPer1000Px": {
          "type": "string",
          "maxLength": 200
        },
        "headingsPer1000Text": {
          "type": "string",
          "maxLength": 200
        },
        "paragraphsPer1000Text": {
          "type": "string",
          "maxLength": 200
        },
        "mainBlocks": {
          "type": "string",
          "maxLength": 200
        },
        "peripheralBlocks": {
          "type": "string",
          "maxLength": 200
        },
        "linkCount": {
          "type": "string",
          "maxLength": 200
        },
        "interactivePer1000Px": {
          "type": "string",
          "maxLength": 200
        },
        "underlinedLinkRatio": {
          "type": "string",
          "maxLength": 200
        },
        "footerLinkCount": {
          "type": "string",
          "maxLength": 200
        },
        "autoplayCount": {
          "type": "string",
          "maxLength": 200
        },
        "qrCodeCount": {
          "type": "string",
          "maxLength": 200
        },
        "meanSaturation": {
          "type": "string",
          "maxLength": 200
        },
        "meanLightness": {
          "type": "string",
          "maxLength": 200
        },
        "distinctHues": {
          "type": "string",
          "maxLength": 200
        },
        "whitespaceRatio": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
