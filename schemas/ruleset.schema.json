{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit Rule Set",
  "type": "object",
  "required": ["profile", "version", "rules"],
  "properties": {
    "profile": {
      "enum": ["western", "china", "hybrid"]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "rule.schema.json"
      }
    }
  }
}
