{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit Market Profile",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "reliability",
    "evidenceRefs",
    "configuration"
  ],
  "properties": {
    "id": {
      "enum": ["western", "china", "hybrid"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reliability": {
      "enum": ["strong", "moderate", "emerging", "hypothesis"]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configuration": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,40}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,40}$"
      },
      "description": "One pole per dimension (see dimensions.schema.json). A dimension that is missing keeps the page as it is."
    }
  }
}
