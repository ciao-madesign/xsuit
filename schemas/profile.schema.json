{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit Market Profile",
  "type": "object",
  "required": ["id", "name", "description", "version", "reliability", "evidenceRefs"],
  "properties": {
    "id": {
      "enum": ["western", "china", "hybrid"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reliability": {
      "enum": ["strong", "moderate", "emerging", "hypothesis"]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "composition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile", "ruleIds"],
        "properties": {
          "profile": {
            "enum": ["western", "china"]
          },
          "ruleIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
