{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xsuit dimensions registry",
  "type": "object",
  "required": ["version", "dimensions"],
  "properties": {
    "version": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "family", "description", "poles"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": ["visual", "information-architecture"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "poles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "description"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "measures": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,40}$"
            },
            "description": "Page metrics that describe this dimension (our own approximate operationalisation)."
          }
        }
      }
    }
  }
}
